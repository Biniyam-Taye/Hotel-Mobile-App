# Server
PORT=3000
NODE_ENV=development
API_VERSION=v1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/luxestay
# Set to true for dev without installing MongoDB (data resets on restart)
USE_MEMORY_DB=false

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd

# CORS (comma-separated origins for Flutter web/mobile)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Platform
PLATFORM_COMMISSION_PERCENT=15
